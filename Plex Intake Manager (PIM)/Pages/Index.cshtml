@page
@model PIM.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Plex Integrity Manager";
    ViewData["FullWidth"] = true;
}

<!-- =========================================================
     🏠 PAGE HEADER
========================================================= -->

<h1>Plex Integrity Manager (PIM)</h1>
<div class="alert alert-warning mt-3">
    <strong>Alpha Build:</strong>
    Use PIM only with a test folder or backup copy of your movie library.
    Do not run this against your primary Plex library yet.
</div>

@if (Model.MissingSetupItems.Count > 0)
{
    <div class="alert alert-danger mt-3" id="setupRequiredAlert">
        <strong>Setup required:</strong>
        PIM will not approve any file moves until the following are configured:
        <ul class="mb-0">
            @foreach (var item in Model.MissingSetupItems)
            {
                <li>@item</li>
            }
        </ul>
    </div>
}

@if (Model.PlexCheckDisabled)
{
    <div class="alert alert-warning mt-3" id="plexCheckDisabledAlert">
        <strong>Plex library check is turned off</strong> (<code>Plex:Enabled</code> is set to <code>false</code>).
        PIM is not checking whether a movie is already in your Plex library, so it can approve moves that duplicate movies Plex already has.
        Remove the setting or set it to <code>true</code> to turn the check back on.
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info mt-3">
        @TempData["Message"]
    </div>
}

<!-- =========================================================
     📁 LIBRARY SETTINGS
========================================================= -->

<div class="card mb-4">
    <div class="card-header">
        <strong>Library Settings</strong>
    </div>
    <div class="card-body">

        <form method="post" asp-page-handler="SaveSettings">
            @Html.AntiForgeryToken()

            <!-- Source Folder -->
            <div class="mb-3">
                <label asp-for="ScanPath" class="form-label">
                    Source Folder (Scan Location)
                </label>
                <input asp-for="ScanPath" class="form-control" />
            </div>

            <!-- Destination Folder -->
            <div class="mb-3">
                <label asp-for="OutputPath" class="form-label">
                    Destination Folder (Output Location)
                </label>
                <input asp-for="OutputPath" class="form-control" />
            </div>

            <!-- Workflow policy -->
            <fieldset class="mb-3">
                <legend class="form-label fs-6">Workflow</legend>

                <div class="form-check mb-2">
                    <input asp-for="LibraryGoal"
                           class="form-check-input"
                           type="radio"
                           id="libraryGoalOrganize"
                           value="@PIM.Core.Models.LibraryGoal.OrganizeNewMovies" />
                    <label class="form-check-label" for="libraryGoalOrganize">
                        <strong>Organize New Movies</strong>
                        <span class="badge bg-primary ms-1">Default</span><br />
                        <span class="text-muted">
                            @PIM.Core.Models.LibraryGoalSettings.GetDescription(PIM.Core.Models.LibraryGoal.OrganizeNewMovies)
                        </span>
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="LibraryGoal"
                           class="form-check-input"
                           type="radio"
                           id="libraryGoalReorganization"
                           value="@PIM.Core.Models.LibraryGoal.ReorganizationMigration" />
                    <label class="form-check-label" for="libraryGoalReorganization">
                        <strong>Reorganize / Migrate</strong><br />
                        <span class="text-muted">
                            @PIM.Core.Models.LibraryGoalSettings.GetDescription(PIM.Core.Models.LibraryGoal.ReorganizationMigration)
                        </span>
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="LibraryGoal"
                           class="form-check-input"
                           type="radio"
                           id="libraryGoalConsolidation"
                           value="@PIM.Core.Models.LibraryGoal.Consolidation" />
                    <label class="form-check-label" for="libraryGoalConsolidation">
                        <strong>Consolidate &amp; Save Space</strong><br />
                        <span class="text-muted">
                            @PIM.Core.Models.LibraryGoalSettings.GetDescription(PIM.Core.Models.LibraryGoal.Consolidation)
                        </span>
                    </label>
                </div>
            </fieldset>

            <!-- Save Settings -->
            <button type="submit" class="btn btn-secondary">
                💾 Save Settings
            </button>
        </form>

    </div>
</div>

<!-- =========================================================
     🎨 VISUAL THEME
========================================================= -->

<style>
    .row-error {
        background-color: #f8d7da;
    }

    .row-review {
        background-color: #cce5ff;
    }

    .row-delete {
        background-color: #ffe4ef;
    }

    .row-best {
        background-color: #fff3cd;
    }

    .row-alt {
        background-color: #d4edda;
    }

    .text-error {
        color: #842029;
    }

    .text-review {
        color: #084298;
    }

    .text-delete {
        color: #8a1538;
    }

    .text-best {
        color: #856404;
    }

    .text-alt {
        color: #0f5132;
    }

    .tag {
        margin-left: 10px;
        font-size: 0.75em;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .tag-error {
        background-color: #f8d7da;
        color: #842029;
    }

    .tag-review {
        background-color: #cce5ff;
        color: #084298;
    }

    .tag-delete {
        background-color: #ffe4ef;
        color: #8a1538;
    }

    .tag-best {
        background-color: #fff3cd;
        color: #856404;
    }

    .tag-alt {
        background-color: #d4edda;
        color: #0f5132;
    }

    .movie-filter-card,
    .dry-run-filter-card {
        cursor: pointer;
    }

    .movie-filter-card.active,
    .dry-run-filter-card.active {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
    }

    /* Movie Results: one compact line per movie, details on demand. */
    .movie-filter-card {
        min-width: 9rem;
    }

    .movie-results .summary-line,
    .movie-results .path-line {
        max-width: 80ch;
    }

    .movie-results .movie-details-row > td {
        background-color: #f8f9fa;
        border-top: 0;
        padding: 0.75rem 1rem;
    }

    .movie-results .movie-details-row dl {
        margin-bottom: 0;
    }
</style>

<!-- =========================================================
     🔄 WORKFLOW CONTROL PANEL
========================================================= -->
<!-- Hidden form used by JavaScript for Scan and Enrich -->
<form method="post" id="workflowForm">
    @Html.AntiForgeryToken()
</form>

<div style="margin-bottom:20px; padding:12px; border:1px solid #ccc;">

    <div style="margin-bottom:10px;">
        <strong>Selected Workflow:</strong>
        <span class="badge bg-dark ms-1">
            @PIM.Core.Models.LibraryGoalSettings.GetDisplayName(Model.LibraryGoal)
        </span>
        <div class="text-muted mt-1" style="font-size:0.9em;">
            @PIM.Core.Models.LibraryGoalSettings.GetDescription(Model.LibraryGoal)
        </div>
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">

        <!-- Full Scan -->
        <button type="button" id="scanBtn">
            🎬 Scan Movies
        </button>

        <!-- Retrieve Metadata -->
        <button type="button"
                id="enrichBtn"
                disabled="@(!Model.Movies.Any())">
            🔎 Identify Movies
        </button>

        <!-- Apply Changes Form -->
        <form method="post"
              asp-page-handler="Commit"
              style="display:inline-flex; align-items:center; gap:10px; margin:0;">
            @Html.AntiForgeryToken()

            <!-- Dry Run -->
            <label style="display:flex; align-items:center; gap:6px; margin:0;">
                <input asp-for="DryRun" />
                <span>Dry Run</span>
            </label>

            @if (Model.DryRun)
            {
                <span class="text-success" style="font-size:0.85em;">
                    <!--Dry Run enabled — no files will be moved or renamed.-->
                </span>
            }
            else
            {
                <span class="text-danger" style="font-size:0.85em;">
                    Live mode — approved files may be moved and renamed.
                </span>
            }

            <!-- Apply Changes -->
            <button type="submit"
                    class="btn btn-success"
                    disabled="@(!Model.Movies.Any(m => m.ApprovedForCommit))">
                🚀 Apply Changes
            </button>
        </form>

        <!-- Cancel (reserved for future use) -->
        <button type="button"
                id="cancelBtn"
                disabled>
            ⛔ Cancel
        </button>

    </div>

    <!-- Real-time status text -->
    <div id="workflowStatus"
         style="margin-top:10px; font-style:italic;">
        Ready
    </div>

</div>

<!-- =========================================================
     📊 SUMMARY
========================================================= -->

<p>
    <strong>Total Movies: @Model.Movies.Count</strong>
</p>

<br />

<!-- =========================================================
     🧪 DRY RUN PREVIEW
========================================================= -->
@if (Model.DryRunPreview != null)
{
    <div id="dryRunPreviewSection" class="card mb-4 border-primary shadow-sm">

        <div class="card-header bg-primary text-white">
            <strong>🧪 Dry Run Preview</strong>
        </div>

        <div class="card-body">

            <p class="text-muted mb-4">
                No files have been changed yet. This preview shows what PIM would do
                if you run the commit live.
                <br />
                <strong>Total Previewed Files:</strong> @Model.DryRunPreview.TotalFiles
                <br />
                <strong>Workflow:</strong>
                @PIM.Core.Models.LibraryGoalSettings.GetDisplayName(Model.DryRunPreview.LibraryGoal)
            </p>

            <!-- Summary Filter Cards -->
            <div class="row mb-4" id="dryRunFilterCards">

                <div class="col-md-3 mb-3">
                    <button type="button"
                            class="card h-100 text-center w-100 dry-run-filter-card"
                            data-preview-filter="move"
                            style="cursor:pointer;">
                        <div class="card-body">
                            <h5 class="card-title">Move / Rename</h5>
                            <div class="display-6">
                                @Model.DryRunPreview.ReadyToMoveCount
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button type="button"
                            class="card h-100 text-center w-100 dry-run-filter-card"
                            data-preview-filter="duplicate"
                            style="cursor:pointer;">
                        <div class="card-body">
                            <h5 class="card-title">Duplicates to Skip</h5>
                            <div class="display-6">
                                @Model.DryRunPreview.DuplicateSkipCount
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button type="button"
                            class="card h-100 text-center w-100 dry-run-filter-card"
                            data-preview-filter="review"
                            style="cursor:pointer;">
                        <div class="card-body">
                            <h5 class="card-title">Needs Review</h5>
                            <div class="display-6">
                                @Model.DryRunPreview.NeedsReviewCount
                            </div>
                        </div>
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button type="button"
                            class="card h-100 text-center w-100 dry-run-filter-card"
                            data-preview-filter="error"
                            style="cursor:pointer;">
                        <div class="card-body">
                            <h5 class="card-title">Errors</h5>
                            <div class="display-6">
                                @Model.DryRunPreview.ErrorCount
                            </div>
                        </div>
                    </button>
                </div>

            </div>

            <div class="mb-3">
                <small id="dryRunFilterStatus" class="text-muted">
                    Showing all dry run preview items.
                </small>
            </div>
            <!-- Detailed Preview Table -->
            <div style="max-height:500px; overflow:auto;">

                <table class="table table-sm table-striped table-bordered align-middle">

                    <thead class="table-light">
                        <tr>
                            <th style="width:150px;">Action</th>
                            <th>Original File</th>
                            <th>Target Path</th>
                            <th style="width:300px;">Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.DryRunPreview.Items)
                        {
                            var previewCategory =
                            item.Action.Contains("Move", StringComparison.OrdinalIgnoreCase) ||
                            item.Action.Contains("Rename", StringComparison.OrdinalIgnoreCase)
                            ? "move"
                            : item.Action.Contains("Duplicate", StringComparison.OrdinalIgnoreCase) ||
                            item.Action.Contains("Skip", StringComparison.OrdinalIgnoreCase)
                            ? "duplicate"
                            : item.Action.Contains("Review", StringComparison.OrdinalIgnoreCase)
                            ? "review"
                            : item.Action.Contains("Error", StringComparison.OrdinalIgnoreCase)
                            ? "error"
                            : "other";

                            <tr class="dry-run-preview-row"
                                data-preview-category="@previewCategory">
                                <td>
                                    <strong>@item.Action</strong>
                                </td>

                                <td style="font-size:0.85em;">
                                    @item.OriginalFilePath
                                </td>

                                <td style="font-size:0.85em; color:green;">
                                    @if (!string.IsNullOrWhiteSpace(item.TargetPath))
                                    {
                                        @item.TargetPath
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <div>@item.Status</div>

                                    @if (item.NeedsReview)
                                    {
                                        <div class="alert alert-primary mt-2 mb-0 p-2" style="font-size:0.85em;">
                                            <div class="fw-bold">Execution blocked — review required</div>
                                            <div><strong>Parsed identity:</strong> @item.ParsedTitle (@(item.ParsedYear?.ToString() ?? "year unknown"))</div>
                                            <div><strong>IMDb ID:</strong> @(string.IsNullOrWhiteSpace(item.ParsedImdbId) ? "Not determined" : item.ParsedImdbId)</div>
                                            <div><strong>Edition:</strong> @(string.IsNullOrWhiteSpace(item.Edition) ? "Standard" : item.Edition)</div>
                                            @if (item.MetadataConfidence.HasValue)
                                            {
                                                <div><strong>Metadata confidence:</strong> @item.MetadataConfidence.Value.ToString("0")%</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.MetadataFailureDetail))
                                            {
                                                <div><strong>Metadata diagnostic:</strong> @item.MetadataFailureDetail</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.MetadataDiscoveryReason))
                                            {
                                                <div><strong>Candidate discovery:</strong> @item.MetadataDiscoveryReason</div>
                                            }
                                            @if (item.HasMetadataSuggestion)
                                            {
                                                <div class="mt-1">
                                                    <strong>Suggested match:</strong>
                                                    @item.SuggestedTitle (@(item.SuggestedYear?.ToString() ?? "year unknown")) — @item.SuggestedImdbId
                                                </div>
                                            }
                                            @if (item.IsDuplicate)
                                            {
                                                <div><strong>Duplicate decision:</strong> @(item.KeepRecommended ? "Recommended copy" : "Not selected as the preferred copy")</div>
                                            }
                                        </div>
                                    }

                                    @if (item.HasDestinationConflict)
                                    {
                                        <div class="alert alert-warning mt-2 mb-0 p-2" style="font-size:0.85em;">
                                            <div class="fw-bold">Destination Conflict</div>

                                            <div>
                                                <strong>Reason:</strong>
                                                @item.DestinationConflictReason
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.ExistingDestinationPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Existing Path:</strong>
                                                    <div class="text-break">@item.ExistingDestinationPath</div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.TargetPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Proposed Path:</strong>
                                                    <div class="text-break">@item.TargetPath</div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (item.HasPlexLibraryConflict)
                                    {
                                        <div class="alert alert-info mt-2 mb-0 p-2" style="font-size:0.85em;">
                                            <div class="fw-bold">
                                                @(item.NeedsPlexDuplicateDecision
                                                    ? "Possible duplicate — decide on the Movie Results tab"
                                                    : "Plex Library Conflict")
                                            </div>

                                            <div>
                                                <strong>Reason:</strong>
                                                @item.PlexLibraryConflictReason
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.ExistingPlexLibraryPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Existing Plex Path:</strong>
                                                    <div class="text-break">@item.ExistingPlexLibraryPath</div>
                                                </div>
                                                <div>
                                                    <strong>Plex copy:</strong> @(item.ExistingPlexResolution ?? "resolution unknown"), @PIM.Core.Models.VideoResolution.FormatSize(item.ExistingPlexSizeBytes)
                                                </div>
                                                <div>
                                                    <strong>This file:</strong> @(item.SourceResolution ?? "resolution not in file name"), @PIM.Core.Models.VideoResolution.FormatSize(item.SourceSizeBytes)
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.TargetPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Proposed Path:</strong>
                                                    <div class="text-break">@item.TargetPath</div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (item.IsPlexDuplicateAccepted)
                                    {
                                        <div class="alert alert-success mt-2 mb-0 p-2" style="font-size:0.85em;">
                                            <div class="fw-bold">Adding alongside the existing Plex copy (your decision)</div>
                                            <div class="text-break"><strong>Existing Plex Path:</strong> @item.ExistingPlexLibraryPath</div>
                                            <div>
                                                <strong>Plex copy:</strong> @(item.ExistingPlexResolution ?? "resolution unknown"), @PIM.Core.Models.VideoResolution.FormatSize(item.ExistingPlexSizeBytes)
                                            </div>
                                            <div>
                                                <strong>This file:</strong> @(item.SourceResolution ?? "resolution not in file name"), @PIM.Core.Models.VideoResolution.FormatSize(item.SourceSizeBytes)
                                            </div>
                                        </div>
                                    }

                                    @if (item.IsPlexTrackedMigration)
                                    {
                                        <div class="alert alert-success mt-2 mb-0 p-2" style="font-size:0.85em;">
                                            <div class="fw-bold">Plex-tracked migration</div>

                                            <div>@item.PlexTrackedMigrationReason</div>

                                            @if (!string.IsNullOrWhiteSpace(item.ExistingPlexLibraryPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Existing Plex Path:</strong>
                                                    <div class="text-break">@item.ExistingPlexLibraryPath</div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.TargetPath))
                                            {
                                                <div class="mt-1">
                                                    <strong>Proposed Path:</strong>
                                                    <div class="text-break">@item.TargetPath</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>
}

<!-- =========================================================
     📑 RESULTS TABS
========================================================= -->
<div class="mt-4">

    <!-- Tab Headers -->
    <ul class="nav nav-tabs" id="resultsTabs" role="tablist">

        <!-- Movie Results -->
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="movies-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#movies-pane"
                    type="button"
                    role="tab">
                🎬 Movie Results
            </button>
        </li>

        @if (Model.Movies.Any())
        {
            <!-- Preview Tree -->
            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="preview-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#preview-pane"
                        type="button"
                        role="tab">
                    🌳 Preview Tree
                </button>
            </li>
        }
    </ul>

    <!-- Tab Content -->
    <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white shadow-sm">

        <!-- =================================================
             🎬 MOVIE RESULTS TAB
        ================================================== -->
        <div class="tab-pane fade show active"
             id="movies-pane"
             role="tabpanel">

            @{
                var resultRows = Model.ResultRows;
                var recommendedValue = Model.ShowOnlyRecommended.ToString().ToLowerInvariant();
                var stateCards = new[]
                {
                    (Key: "decide", Label: "Your decision", Css: "text-primary", Hint: "PIM needs you to choose; use the buttons on each row"),
                    (Key: "blocked", Label: "Blocked", Css: "text-warning-emphasis", Hint: "Fix the cause outside PIM, then run a new dry run"),
                    (Key: "error", Label: "Errors", Css: "text-danger", Hint: "Could not be processed"),
                    (Key: "ready", Label: "Ready", Css: "text-success", Hint: "Will be moved by a live commit after a dry run"),
                    (Key: "skipped", Label: "Skipped", Css: "text-secondary", Hint: "Duplicate copies left where they are; nothing is deleted"),
                    (Key: "pending", Label: "Not identified", Css: "text-muted", Hint: "Run Identify Movies")
                };
            }

            <div class="d-flex flex-wrap gap-2 mb-2"
                 id="movieFilterCards"
                 data-default-filter="@(resultRows.Any(row => row.State == MovieResultState.Decide) ? "decide" : "all")">
                @foreach (var card in stateCards)
                {
                    var count = resultRows.Count(row => row.FilterKey == card.Key);

                    if (card.Key == "pending" && count == 0)
                    {
                        continue;
                    }

                    <button type="button"
                            class="card movie-filter-card flex-row align-items-baseline gap-2 px-3 py-2"
                            data-movie-filter="@card.Key"
                            aria-pressed="false"
                            title="@card.Hint">
                        <span class="fs-5 fw-bold @card.Css">@count</span>
                        <span>@card.Label</span>
                    </button>
                }
                <button type="button"
                        class="btn btn-link btn-sm align-self-center"
                        id="movieFilterShowAll">
                    Show all @resultRows.Count
                </button>
            </div>

            <p id="movieFilterStatus" class="text-muted small mb-2"></p>

            @if (!resultRows.Any())
            {
                <p class="text-muted">No movies scanned yet. Use <strong>Scan Movies</strong> to begin.</p>
            }
            else
            {
                <table class="table table-sm table-hover align-middle movie-results mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:9rem;">Status</th>
                            <th>Movie</th>
                            <th>What PIM found</th>
                            <th class="text-end" style="width:1%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in resultRows)
                        {
                            var movie = row.Movie;
                            var rowId = $"movie-{movie.Id:N}";
                            var detailsId = $"details-{movie.Id:N}";
                            var showPlex = movie.HasPlexLibraryConflict ||
                                           movie.IsPlexDuplicateAccepted ||
                                           movie.IsPlexTrackedMigration;

                            <tr class="movie-results-row"
                                id="@rowId"
                                data-movie-category="@row.FilterKey"
                                data-details-id="@detailsId">
                                <td>
                                    <span class="badge @row.BadgeClass">@row.StateLabel</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        @row.DisplayTitle
                                        @if (movie.Year.HasValue && !string.IsNullOrWhiteSpace(movie.Title))
                                        {
                                            <span class="fw-normal">(@movie.Year)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(movie.VersionTag))
                                        {
                                            <span class="badge text-bg-light border fw-normal ms-1">@movie.VersionTag</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(movie.SourceResolution))
                                        {
                                            <span class="badge text-bg-light border fw-normal ms-1">@movie.SourceResolution</span>
                                        }
                                    </div>
                                    <div class="small text-muted text-truncate path-line" title="@movie.OriginalFilePath">
                                        @row.SourceDisplay
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate summary-line" title="@row.Summary">@row.Summary</div>
                                    @if (row.AdditionalReasonCount > 0)
                                    {
                                        <div class="small text-muted">
                                            +@row.AdditionalReasonCount more @(row.AdditionalReasonCount == 1 ? "reason" : "reasons") in Details
                                        </div>
                                    }
                                    else if (row.State == MovieResultState.Ready && row.TargetDisplay != null)
                                    {
                                        <div class="small text-muted text-truncate path-line" title="@movie.TargetPath">
                                            → @row.TargetDisplay
                                        </div>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (row.CanAddPlexDuplicate)
                                        {
                                            <form method="post" asp-page-handler="AddPlexDuplicate" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="movieId" value="@movie.Id" />
                                                <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        title="Move this file too. Plex will then have both copies. Nothing is deleted.">
                                                    Add anyway
                                                </button>
                                            </form>
                                        }
                                        @if (row.CanUndoPlexDuplicate)
                                        {
                                            <form method="post" asp-page-handler="UndoPlexDuplicate" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="movieId" value="@movie.Id" />
                                                <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Skip this file again because Plex already has the movie.">
                                                    Undo add
                                                </button>
                                            </form>
                                        }
                                        @if (row.CanKeepThisCopy)
                                        {
                                            <form method="post" asp-page-handler="KeepDuplicateCopy" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="movieId" value="@movie.Id" />
                                                <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        title="Keep this copy (@PIM.Core.Models.VideoResolution.FormatSize(movie.FileSizeBytes)); the other copies are skipped, not deleted.">
                                                    Keep this copy
                                                </button>
                                            </form>
                                        }
                                        @if (row.CanAcceptSuggestion)
                                        {
                                            <form method="post" asp-page-handler="AcceptSuggestedMatch" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="movieId" value="@movie.Id" />
                                                <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        title="Accept @movie.SuggestedTitle (@movie.SuggestedYear), @movie.SuggestedImdbId">
                                                    Accept match
                                                </button>
                                            </form>
                                        }
                                        @if (row.CanConfirmFileName)
                                        {
                                            <form method="post" asp-page-handler="ConfirmFileName" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="movieId" value="@movie.Id" />
                                                <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        title="Confirm this file is the movie shown, despite its long name.">
                                                    Confirm name
                                                </button>
                                            </form>
                                        }
                                        @if (row.CanEnterImdbId)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-open-details="@detailsId"
                                                    data-focus="imdb-@movie.Id">
                                                Enter IMDb ID
                                            </button>
                                        }
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-toggle-details="@detailsId"
                                                aria-expanded="false"
                                                aria-controls="@detailsId">
                                            Details
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <tr class="movie-details-row" id="@detailsId" hidden>
                                <td colspan="4">
                                    <div class="row g-3 small">
                                        <div class="col-lg-6">
                                            @if (movie.HasError)
                                            {
                                                <div class="text-danger mb-2"><strong>Error:</strong> @movie.ErrorMessage</div>
                                            }
                                            @if (row.Reasons.Count > 0)
                                            {
                                                <div class="fw-semibold">Why this needs attention</div>
                                                <ul class="mb-2 ps-3">
                                                    @foreach (var reason in row.Reasons)
                                                    {
                                                        <li>@reason</li>
                                                    }
                                                </ul>
                                            }
                                            @if (row.CanKeepThisCopy)
                                            {
                                                <p class="mb-2">
                                                    Other copies of this movie and edition are too close in size to pick one automatically.
                                                    <strong>Keep this copy</strong> (@PIM.Core.Models.VideoResolution.FormatSize(movie.FileSizeBytes)) marks the others as skipped. No file is deleted.
                                                </p>
                                            }
                                            @if (row.CanConfirmFileName)
                                            {
                                                <p class="mb-2">
                                                    This file name is unusually long (@(movie.FileName?.Length ?? 0) characters), which can mean a sample, a bundle, or a mislabeled file.
                                                    Check the file, then use <strong>Confirm name</strong>.
                                                </p>
                                            }
                                            @if (movie.HasMetadataSuggestion)
                                            {
                                                <p class="mb-2">
                                                    <strong>Suggested match:</strong>
                                                    @movie.SuggestedTitle (@(movie.SuggestedYear?.ToString() ?? "year unknown")), @movie.SuggestedImdbId
                                                    @if (!movie.CanAcceptMetadataSuggestion)
                                                    {
                                                        <br />
                                                        <span>OMDb did not provide a release year, so this suggestion cannot be accepted safely.</span>
                                                    }
                                                </p>
                                            }
                                            <dl class="row mb-0">
                                                <dt class="col-sm-4">Identity</dt>
                                                <dd class="col-sm-8">
                                                    @(string.IsNullOrWhiteSpace(movie.Title) ? "Unknown title" : movie.Title)
                                                    (@(movie.Year?.ToString() ?? "year unknown"))
                                                </dd>
                                                <dt class="col-sm-4">IMDb ID</dt>
                                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(movie.ImdbId) ? "Not determined" : movie.ImdbId)</dd>
                                                <dt class="col-sm-4">Edition</dt>
                                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(movie.VersionTag) ? "Standard" : movie.VersionTag)</dd>
                                                <dt class="col-sm-4">This file</dt>
                                                <dd class="col-sm-8">
                                                    @(movie.SourceResolution ?? "resolution not in file name"),
                                                    @PIM.Core.Models.VideoResolution.FormatSize(movie.FileSizeBytes)
                                                </dd>
                                                @if (movie.MatchConfidence.HasValue)
                                                {
                                                    <dt class="col-sm-4">Match confidence</dt>
                                                    <dd class="col-sm-8">@movie.MatchConfidence.Value.ToString("0")%</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(movie.MetadataLookupFailureDetail))
                                                {
                                                    <dt class="col-sm-4">Lookup detail</dt>
                                                    <dd class="col-sm-8">@movie.MetadataLookupFailureDetail</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(movie.MetadataDiscoveryReason))
                                                {
                                                    <dt class="col-sm-4">How it was found</dt>
                                                    <dd class="col-sm-8">@movie.MetadataDiscoveryReason</dd>
                                                }
                                            </dl>
                                        </div>

                                        <div class="col-lg-6">
                                            @if (showPlex)
                                            {
                                                <div class="border rounded p-2 mb-2 bg-white">
                                                    <div class="fw-semibold">
                                                        @(movie.NeedsPlexDuplicateDecision
                                                            ? "Possible duplicate: your decision"
                                                            : movie.IsPlexDuplicateAccepted
                                                                ? "Possible duplicate: you chose to add it"
                                                                : movie.IsPlexTrackedMigration
                                                                    ? "Plex tracks this file"
                                                                    : "Plex library conflict")
                                                    </div>
                                                    <div>
                                                        @(movie.IsPlexTrackedMigration
                                                            ? movie.PlexTrackedMigrationReason
                                                            : movie.PlexLibraryConflictReason)
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(movie.ExistingPlexLibraryPath))
                                                    {
                                                        <div class="text-break mt-1">
                                                            <span class="text-muted">Plex copy:</span>
                                                            @(movie.ExistingPlexResolution ?? "resolution unknown"),
                                                            @PIM.Core.Models.VideoResolution.FormatSize(movie.ExistingPlexSizeBytes),
                                                            @movie.ExistingPlexLibraryPath
                                                        </div>
                                                        <div>
                                                            <span class="text-muted">This file:</span>
                                                            @(movie.SourceResolution ?? "resolution not in file name"),
                                                            @PIM.Core.Models.VideoResolution.FormatSize(movie.FileSizeBytes)
                                                        </div>
                                                    }
                                                    @if (movie.NeedsPlexDuplicateDecision)
                                                    {
                                                        <div class="mt-1">
                                                            This file is <strong>skipped</strong> unless you choose <strong>Add anyway</strong>.
                                                            Adding it moves it to the proposed path and Plex will then have both copies. Nothing is deleted.
                                                        </div>
                                                    }
                                                    @if (movie.IsPlexDuplicateAccepted)
                                                    {
                                                        <div class="mt-1">Plex will have both copies after the move. Nothing is deleted. Use <strong>Undo add</strong> to skip it again.</div>
                                                    }
                                                </div>
                                            }
                                            @if (movie.HasDestinationConflict)
                                            {
                                                <div class="border rounded p-2 mb-2 bg-white">
                                                    <div class="fw-semibold">Destination conflict</div>
                                                    <div>@movie.DestinationConflictReason</div>
                                                    @if (!string.IsNullOrWhiteSpace(movie.ExistingDestinationPath))
                                                    {
                                                        <div class="text-break"><span class="text-muted">Existing:</span> @movie.ExistingDestinationPath</div>
                                                    }
                                                </div>
                                            }
                                            <div class="fw-semibold">Paths</div>
                                            <div class="text-break"><span class="text-muted">From:</span> @movie.OriginalFilePath</div>
                                            <div class="text-break">
                                                <span class="text-muted">To:</span>
                                                @(string.IsNullOrWhiteSpace(movie.TargetPath) ? "No destination until the identity is confirmed" : movie.TargetPath)
                                            </div>
                                            @if (row.CanEnterImdbId)
                                            {
                                                <form method="post" asp-page-handler="SetImdbId" class="mt-2 p-2 bg-white border rounded">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="movieId" value="@movie.Id" />
                                                    <input type="hidden" name="ShowOnlyRecommended" value="@recommendedValue" />
                                                    <label class="form-label mb-1" for="imdb-@movie.Id">
                                                        @(movie.HasMetadataSuggestion ? "Not the right movie? Enter its IMDb ID:" : "Know the movie? Enter its IMDb ID:")
                                                    </label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text"
                                                               class="form-control"
                                                               id="imdb-@movie.Id"
                                                               name="imdbId"
                                                               placeholder="tt0088794 or IMDb page link"
                                                               maxlength="500"
                                                               autocomplete="off"
                                                               required />
                                                        <button type="submit" class="btn btn-outline-primary">Look Up</button>
                                                    </div>
                                                    <div class="form-text">
                                                        PIM checks the ID with OMDb. If it doesn't match this file's title or year, you'll be asked to confirm the movie it points to.
                                                    </div>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (Model.Movies.Any())
        {
            <!-- =================================================
                 🌳 PREVIEW TREE TAB
            ================================================== -->
            <div class="tab-pane fade"
                 id="preview-pane"
                 role="tabpanel">

                <p style="color:#084298;">
                    🔍 @Model.Movies.Count(m => m.NeedsReview)
                    movies require review and are shown in the Preview Tree under
                    <strong>Needs Review</strong>.
                </p>

                <p style="color:#842029;">
                    ❌ @Model.Movies.Count(m => m.HasError)
                    movies have errors and are shown in the Preview Tree under
                    <strong>Errors</strong>.
                </p>

                @if (Model.PreviewTree != null)
                {
                    <div style="max-height:700px; overflow:auto;">
                        <ul>
                            @{
                                RenderNode(Model.PreviewTree);
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <p style="color:gray;">
                        No preview available.
                        Run a scan to generate the file structure.
                    </p>
                }
            </div>
        }
    </div>
</div>
<!-- =========================================================
     ⚡ WORKFLOW SCRIPT
========================================================= -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // 🔐 Anti-forgery token used for POST requests
        // =====================================================
        const tokenInput =
            document.querySelector('input[name="__RequestVerificationToken"]');

        if (!tokenInput) {
            console.error("CSRF token not found");
            return;
        }

        // =====================================================
        // 📢 Status area shown in the Workflow panel
        // =====================================================
        const workflowStatus =
            document.getElementById("workflowStatus");

    // =====================================================
    // 🔄 FULL SCAN
    // =====================================================
    const scanBtn = document.getElementById("scanBtn");

    if (scanBtn) {
        scanBtn.addEventListener("click", async () => {

            // -------------------------------------------------
            // 🧪 Clear stale Dry Run Preview immediately
            // -------------------------------------------------
            const dryRunPreviewSection =
                document.getElementById("dryRunPreviewSection");

            if (dryRunPreviewSection) {
                dryRunPreviewSection.remove();
            }

            workflowStatus.innerText = "Scanning movie files...";

            // Start polling immediately so the UI updates
            // while the server is processing.
            pollProgress("Scan complete!");

            // Launch scan in the background.
            const response = await fetch("?handler=Rescan", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": tokenInput.value
                }
            });

            if (!response.ok) {
                workflowStatus.innerText = "Scan failed.";
            }
        });
    }
        // =====================================================
        // 🌐 RETRIEVE METADATA
        // =====================================================
        const enrichBtn = document.getElementById("enrichBtn");

        if (enrichBtn) {
            enrichBtn.addEventListener("click", async () => {

                workflowStatus.innerText = "Identifying movies and preparing matches...";

                // Start polling immediately so the UI updates
                // while metadata is being retrieved.
                pollProgress("Movie identification complete!");

                // Launch metadata retrieval in the background.
                const response = await fetch("?handler=Enrich", {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": tokenInput.value
                    }
                });

                if (!response.ok) {
                    workflowStatus.innerText =
                        "Metadata enrichment failed.";
                }
            });
        }
        // =====================================================
        // 🎬 MOVIE RESULTS: FILTERS, DETAILS, AND PLACE KEEPING
        // =====================================================
        const movieFilterStorageKey = "pim.movieFilter";
        const moviePositionStorageKey = "pim.movieResultsPosition";

        const movieFilterCards =
            document.querySelectorAll(".movie-filter-card");

        const movieRows =
            document.querySelectorAll(".movie-results-row");

        const movieFilterStatus =
            document.getElementById("movieFilterStatus");

        const movieFilterContainer =
            document.getElementById("movieFilterCards");

        let activeMovieFilter = null;

        // Browser storage can be unavailable (private mode, blocked site
        // data); the page must still work without it.
        function readStoredValue(key) {
            try {
                return window.sessionStorage.getItem(key);
            } catch {
                return null;
            }
        }

        function writeStoredValue(key, value) {
            try {
                if (value === null) {
                    window.sessionStorage.removeItem(key);
                } else {
                    window.sessionStorage.setItem(key, value);
                }
            } catch {
                // Remembering the view is a convenience only.
            }
        }

        function detailsToggleFor(detailsId) {
            return document.querySelector(`[data-toggle-details="${detailsId}"]`);
        }

        function setDetailsOpen(toggle, open) {
            const details = document.getElementById(toggle.dataset.toggleDetails);

            if (!details) {
                return;
            }

            details.hidden = !open;
            toggle.setAttribute("aria-expanded", open.toString());
            toggle.textContent = open ? "Hide details" : "Details";
        }

        function countRows(filter) {
            return document.querySelectorAll(
                `.movie-results-row[data-movie-category="${filter}"]`).length;
        }

        function applyMovieFilter(filter) {
            activeMovieFilter = filter;

            movieFilterCards.forEach(function (card) {
                const isActive = card.dataset.movieFilter === filter;
                card.classList.toggle("border-primary", isActive);
                card.classList.toggle("shadow-sm", isActive);
                card.setAttribute("aria-pressed", isActive.toString());
            });

            let visibleCount = 0;

            movieRows.forEach(function (row) {
                const isVisible =
                    filter === null ||
                    row.dataset.movieCategory === filter;
                const toggle = detailsToggleFor(row.dataset.detailsId);
                const details = document.getElementById(row.dataset.detailsId);

                row.hidden = !isVisible;

                if (details) {
                    details.hidden =
                        !isVisible ||
                        toggle?.getAttribute("aria-expanded") !== "true";
                }

                if (isVisible) {
                    visibleCount++;
                }
            });

            if (movieFilterStatus) {
                movieFilterStatus.textContent =
                    filter === null
                        ? `Showing all ${movieRows.length} movies.`
                        : `Showing ${visibleCount} of ${movieRows.length} movies. ` +
                          "Select the highlighted card again, or Show all, to see everything.";
            }

            writeStoredValue(movieFilterStorageKey, filter ?? "all");
        }

        movieFilterCards.forEach(function (card) {
            card.addEventListener("click", function () {
                const selected = card.dataset.movieFilter;
                applyMovieFilter(activeMovieFilter === selected ? null : selected);
            });
        });

        document.getElementById("movieFilterShowAll")
            ?.addEventListener("click", function () {
                applyMovieFilter(null);
            });

        document.querySelectorAll("[data-toggle-details]").forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                setDetailsOpen(
                    toggle,
                    toggle.getAttribute("aria-expanded") !== "true");
            });
        });

        document.querySelectorAll("[data-open-details]").forEach(function (button) {
            button.addEventListener("click", function () {
                const toggle = detailsToggleFor(button.dataset.openDetails);

                if (toggle) {
                    setDetailsOpen(toggle, true);
                }

                document.getElementById(button.dataset.focus)?.focus();
            });
        });

        // After a row action posts back, return to the same place with the
        // same details open instead of jumping to the top of the page.
        document.querySelectorAll("#movies-pane form").forEach(function (form) {
            form.addEventListener("submit", function () {
                const openDetails = Array.from(
                    document.querySelectorAll("[data-toggle-details][aria-expanded='true']"))
                    .map(function (toggle) { return toggle.dataset.toggleDetails; });

                writeStoredValue(
                    moviePositionStorageKey,
                    JSON.stringify({ y: window.scrollY, openDetails: openDetails }));
            });
        });

        if (movieRows.length > 0) {
            // Open on "Your decision" when there is anything to decide, unless
            // the owner picked a view earlier in this browser tab.
            const defaultFilter = movieFilterContainer?.dataset.defaultFilter ?? "all";
            let initialFilter = readStoredValue(movieFilterStorageKey) ?? defaultFilter;

            if (initialFilter !== "all" && countRows(initialFilter) === 0) {
                initialFilter = defaultFilter;
            }

            applyMovieFilter(initialFilter === "all" ? null : initialFilter);

            const savedPosition = readStoredValue(moviePositionStorageKey);

            if (savedPosition) {
                writeStoredValue(moviePositionStorageKey, null);

                try {
                    const position = JSON.parse(savedPosition);

                    (position.openDetails || []).forEach(function (detailsId) {
                        const toggle = detailsToggleFor(detailsId);
                        const row = document.querySelector(`[data-details-id="${detailsId}"]`);

                        if (toggle && row && !row.hidden) {
                            setDetailsOpen(toggle, true);
                        }
                    });

                    // Scroll after the page has fully loaded; the browser's own
                    // scroll handling on load would otherwise undo it.
                    const restoreScroll = function () {
                        window.requestAnimationFrame(function () {
                            window.scrollTo(0, position.y || 0);
                        });
                    };

                    if (document.readyState === "complete") {
                        restoreScroll();
                    } else {
                        window.addEventListener("load", restoreScroll, { once: true });
                    }
                } catch {
                    // Ignore an unreadable saved position.
                }
            }
        }

        // =====================================================
        // 🧪 DRY RUN PREVIEW CARD FILTERING
        // =====================================================
        let activeDryRunFilter = null;

        const filterCards =
            document.querySelectorAll(".dry-run-filter-card");

        const previewRows =
            document.querySelectorAll(".dry-run-preview-row");

        const filterStatus =
            document.getElementById("dryRunFilterStatus");

        filterCards.forEach(function (card) {
            card.addEventListener("click", function () {

                const selectedFilter =
                    card.dataset.previewFilter;

                // Clicking the same card again clears the filter.
                if (activeDryRunFilter === selectedFilter) {
                    activeDryRunFilter = null;
                } else {
                    activeDryRunFilter = selectedFilter;
                }

                // Reset all card visual states.
                filterCards.forEach(function (c) {
                    c.classList.remove("border-primary", "shadow");
                });

                // Highlight the selected card.
                if (activeDryRunFilter !== null) {
                    card.classList.add("border-primary", "shadow");
                }

                // Show/hide preview rows.
                let visibleCount = 0;

                previewRows.forEach(function (row) {

                    const rowCategory =
                        row.dataset.previewCategory;

                    if (
                        activeDryRunFilter === null ||
                        rowCategory === activeDryRunFilter
                    ) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                // Update helper text.
                if (filterStatus) {
                    if (activeDryRunFilter === null) {
                        filterStatus.textContent =
                            "Showing all dry run preview items.";
                    } else {
                        filterStatus.textContent =
                            `Showing ${visibleCount} dry run preview item(s). ` +
                            "Click the selected card again to clear the filter.";
                    }
                }
            });
        });

        // =====================================================
        // 📊 PROGRESS POLLING
        // =====================================================
        function pollProgress(completionMessage) {

            const startTime = Date.now();

            const interval = setInterval(async () => {

                const progressResponse =
                    await fetch("?handler=Progress");

                const data =
                    await progressResponse.json();

                // ---------------------------------------------
                // ⏱ Calculate elapsed time
                // ---------------------------------------------
                const elapsedMs = Date.now() - startTime;
                const elapsedSeconds =
                    Math.floor(elapsedMs / 1000);

                // ---------------------------------------------
                // 📈 Estimate remaining time
                // ---------------------------------------------
                let remainingText = "Calculating...";

                if (data.processed > 0 && data.total > 0) {
                    const avgSecondsPerItem =
                        elapsedSeconds / data.processed;

                    const remainingSeconds = Math.round(
                        avgSecondsPerItem *
                        (data.total - data.processed)
                    );

                    remainingText =
                        formatTime(remainingSeconds);
                }

                // ---------------------------------------------
                // 📝 Update status text
                // ---------------------------------------------
                workflowStatus.innerHTML =
                    `<strong>Processing ${data.processed} of ${data.total}</strong><br>` +
                    `Current File: ${data.currentFile || "Starting..."}<br>` +
                    `Elapsed: ${formatTime(elapsedSeconds)}<br>` +
                    `Estimated Remaining: ${remainingText}`;

                // ---------------------------------------------
                // ✅ Completed
                // ---------------------------------------------
                if (!data.isRunning) {
                    clearInterval(interval);
                    workflowStatus.innerHTML = completionMessage;
                    location.reload();
                }

            }, 1000);
        }

        // =====================================================
        // ⏱ Format seconds as HH:MM:SS
        // =====================================================
        function formatTime(totalSeconds) {

            const hours =
                Math.floor(totalSeconds / 3600);

            const minutes =
                Math.floor((totalSeconds % 3600) / 60);

            const seconds =
                totalSeconds % 60;

            return [
                hours.toString().padStart(2, "0"),
                minutes.toString().padStart(2, "0"),
                seconds.toString().padStart(2, "0")
            ].join(":");
        }
    });
</script>

<!-- =========================================================
     🌳 PREVIEW TREE RENDERER
========================================================= -->
@functions {

    void RenderNode(PIM.Web.Models.FileNode node)
    {
        if (node.IsFolder)
        {
            <li>
                <details @(node.IsExpanded ? "open" : "")>
                    <summary>
                        📁 @node.Name
                        @(node.FileCount > 1 ? $"({node.FileCount})" : "")
                    </summary>

                    @if (node.Children.Any())
                    {
                        <ul>
                            @foreach (var child in node.Children)
                            {
                                RenderNode(child);
                            }
                        </ul>
                    }
                </details>
            </li>
        }
        else
        {
            var movie = node.Movie;

            var textClass =
                movie?.HasError == true ? "text-error" :
                movie?.NeedsReview == true ? "text-review" :
                (movie?.IsDuplicate == true &&
                 !movie.KeepRecommended &&
                 !movie.IsAlternateVersion)
                    ? "text-delete" :
                movie?.KeepRecommended == true ? "text-best" :
                movie?.IsAlternateVersion == true ? "text-alt" :
                "";

            var tagClass =
                movie?.HasError == true ? "tag tag-error" :
                movie?.NeedsReview == true ? "tag tag-review" :
                (movie?.IsDuplicate == true &&
                 !movie.KeepRecommended &&
                 !movie.IsAlternateVersion)
                    ? "tag tag-delete" :
                movie?.KeepRecommended == true ? "tag tag-best" :
                movie?.IsAlternateVersion == true ? "tag tag-alt" :
                "tag";

            var label =
                movie?.HasError == true ? "❌ FIX" :
                movie?.NeedsReview == true ? "🔍 REVIEW" :
                (movie?.IsDuplicate == true &&
                 !movie.KeepRecommended &&
                 !movie.IsAlternateVersion)
                    ? "🗑 DELETE" :
                movie?.KeepRecommended == true ? "⭐ KEEP" :
                movie?.IsAlternateVersion == true ? "🎬 ALT" :
                "";

            <li style="margin-bottom:4px;">

                <span class="@textClass">
                    📄 @node.Name
                </span>

                @if (!string.IsNullOrEmpty(label))
                {
                    <span class="@tagClass">
                        @label
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(node.Status) &&
                     (movie?.NeedsReview == true || movie?.HasError == true))
                {
                    <span style="font-size:0.8em; color:#666; margin-left:8px;">
                        — @node.Status
                    </span>
                }

            </li>
        }
    }
}
